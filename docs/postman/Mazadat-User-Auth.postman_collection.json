		{
			"name": "Profile - Balance",
			"item": [
				{
					"name": "Get wallet balance / dues / active bids",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/balance",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"balance"
							]
						}
					}
				},
				{
					"name": "Get wallet (balance, totals, cursor-paginated transactions)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/wallet?per_page=15",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"wallet"
							],
							"query": [
								{
									"key": "per_page",
									"value": "15",
									"description": "Optional, 1-100, defaults to 15."
								},
								{
									"key": "cursor",
									"value": "",
									"description": "Optional. Pass the previous response's data.pagination.next_cursor to fetch the next page.",
									"disabled": true
								}
							]
						},
						"description": "Requires auth (Bearer token). Returns:\n- `data.balance`: the user's real, current wallet balance (User.wallet_balance).\n- `data.total_deposits`: real SUM() of every wallet_transactions row for this user with a positive amount, across their entire history.\n- `data.total_withdrawals`: real SUM() of the absolute value of every row with a negative amount, across their entire history.\n- `data.transactions`: cursor-paginated list (newest first), each with `id`, `type` (buyer_debit/seller_credit/partner_credit/adjustment), `amount` (signed), `balance_after`, `description`, `order_number` (nullable), `created_at`.\n- `data.pagination`: `per_page`, `next_cursor` (pass back as the `cursor` query param to page forward, null on the last page), `prev_cursor`, `has_more_pages`.\n\nCursor pagination (not offset-based) is used specifically for performance on long transaction histories."
					}
				}
			]
		},
		{
			"name": "Partners",
			"item": [
				{
					"name": "List partners (with active_auctions_count)",
