							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"partners"
							]
						},
						"description": "Public endpoint (no auth required), paginated (10 per page). Each partner in `data` includes `active_auctions_count` (integer) — the number of that partner's own auctions currently live right now (`live_videos.status = 'start'`, matching the LiveVideo.user_id owned by this partner). 0 if none are live at the moment; always a real, live-computed count, never cached or hardcoded."
					}
				}
			]
		},
