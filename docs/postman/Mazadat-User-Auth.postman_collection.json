{
	"info": {
		"name": "Mazadat - User API",
		"description": "User-facing endpoints: authentication (login by phone or email + password), home-screen auction search/filter, wallet balance, invoice PDF download, and notifications. See docs/api/user-login.md, docs/api/auctions-search-filter.md, docs/api/invoice-pdf-download.md and docs/api/notifications.md for full field/response documentation. Also see docs/api/my-auctions-sales.md for the organizer auctions/sales field. Also see docs/api/user-package-subscription.md for the subscription status/renew endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://mazadat.anaamworld.com.sa/api"
		},
		{
			"key": "api_key",
			"value": ""
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Login",
			"item": [
				{
					"name": "Login with phone",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"0555555555\",\n  \"password\": \"secret123\",\n  \"user_type\": \"buyer\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    if (body.success && body.data && body.data.token) {",
									"        pm.collectionVariables.set('token', body.data.token);",
									"    }",
									"}"
								]
							}
						}
					]
				},
