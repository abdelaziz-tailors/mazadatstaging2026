DirectoryIndex index.php index.html

Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Association responses must reach Laravel even if an old upload left static files.
    # Set cache policy separately: mod_rewrite ignores E flags on per-directory substitutions.
    RewriteRule ^(?:\.well-known/(?:assetlinks\.json|apple-app-site-association)|apple-app-site-association)$ - [E=Cache-Control:no-cache]
    RewriteRule ^(?:\.well-known/(?:assetlinks\.json|apple-app-site-association)|apple-app-site-association)$ index.php [L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>